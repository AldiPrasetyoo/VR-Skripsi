  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "\u2022 <indent=5%>Ketergantungan Mutlak pada LoS: Koneksi akan langsung
    melorot atau bahkan terputus total jika jalur udara antara kedua antena terhalang
    oleh gedung baru, pohon yang tumbuh tinggi, atau perbukitan.</indent>\r\n\r\n\u2022
    <indent=5%>Rentan Terhadap Faktor Cuaca: Kualitas redaman sinyal dapat memburuk
    saat terjadi cuaca ekstrem seperti hujan lebat (rain fade), kabut tebal, atau
    angin kencang yang bisa menggeser posisi presisi antena.</indent>\r\n\r\n\u2022
    <indent=5%>Keterbatasan Skalabilitas (1-ke-1): Sifat koneksinya kaku. Jika di
    kemudian hari ada gedung ketiga yang ingin digabungkan ke jaringan, kita wajib
    menambah sepasang perangkat radio baru lagi.</indent>\r\n\r\n\u2022 <indent=5%>Risiko
    Interferensi Frekuensi: Jika dipasang di area perkotaan yang padat, sinyal PtP
    rentan bertabrakan dengan frekuensi perangkat nirkabel lain di sekitarnya yang
    mengakibatkan koneksi tidak stabil.</indent>"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
  m_sharedMaterial: {fileID: 2180264, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
