      m_Calls: []
  m_text: "\u2022 <indent=5%>Kondisi bebas hambatan berarti jalur sangat bersih tanpa
    ada halangan sama sekali sehingga sinyal sangat kuat.</indent>\r\n\r\n\u2022
    <indent=5%>Kondisi terhalang sebagian berarti ada benda seperti pucuk pohon yang
    menutupi sedikit jalur sehingga sinyal agak turun.</indent>\r\n\r\n\u2022 <indent=5%>Kondisi
    tertutup total berarti ada bangunan besar atau bukit yang menutupi jalur sehingga
    sinyal terputus dan internet tidak bisa lewat.</indent>"
