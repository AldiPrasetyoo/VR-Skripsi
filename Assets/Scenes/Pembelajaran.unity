--- !u!114 &436412572
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 436412570}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Unity.TextMeshPro::TMPro.TextMeshProUGUI
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "\u2022 <indent=5%>Koneksi Sering Putus-Nyambung (Intermittent Link): Kondisi
    di mana status perangkat sesekali terhubung lalu terputus secara acak. Masalah
    ini biasanya ditandai dengan nilai CCQ yang turun-naik secara drastis.</indent>\r\n\r\n\u2022
    <indent=5%>Penurunan Kecepatan Data (Drop Throughput): Status koneksi antar radio
    menunjukkan indikator terhubung (connected), namun kecepatan transfer data riil
    jauh di bawah kapasitas standar perangkat.</indent>\r\n\r\n\u2022 <indent=5%>Latensi
    Tinggi dan RTO (Packet Loss): Waktu respons jaringan membengkak sangat tinggi
    (ping besar) atau bahkan paket data hilang di tengah jalan yang ditandai dengan
    munculnya Request Time Out (RTO).</indent>\r\n\r\n\u2022 <indent=5%>Gagal Terhubung
    Total (Link Down): Perangkat Station sama sekali tidak bisa mendeteksi atau melakukan
    association (registrasi) ke perangkat Access Point pemancar.</indent>"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
  m_sharedMaterial: {fileID: 2180264, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
