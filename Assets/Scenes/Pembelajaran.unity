--- !u!114 &445144517
MonoBehaviour:
  m_ObjectHideFlags: 0
  m_CorrespondingSourceObject: {fileID: 0}
  m_PrefabInstance: {fileID: 0}
  m_PrefabAsset: {fileID: 0}
  m_GameObject: {fileID: 445144515}
  m_Enabled: 1
  m_EditorHideFlags: 0
  m_Script: {fileID: 11500000, guid: f4688fdb7df04437aeb418b961361dc5, type: 3}
  m_Name: 
  m_EditorClassIdentifier: Unity.TextMeshPro::TMPro.TextMeshProUGUI
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "\u2022 <indent=5%>Syarat utama adalah terpenuhinya Line of Sight (LoS),
    yaitu tidak boleh ada halangan fisik yang memotong jalur sinyal antara kedua
    titik lokasi.</indent>\r\n\r\n\u2022 <indent=5%>Membutuhkan sepasang perangkat
    radio wireless yang dikonfigurasi dengan peran yang tepat: satu bertindak sebagai
    Access Point (pemancar) dan satu sebagai Station (penerima).</indent>\r\n\r\n\u2022
    <indent=5%>Kedua perangkat wireless harus diatur beroperasi pada frekuensi atau
    channel yang sama agar dapat saling mendeteksi dan berkomunikasi.</indent>\r\n\r\n\u2022
    <indent=5%>Nama jaringan (SSID) dan pengaturan keamanan (seperti password) pada
    Station harus disamakan persis dengan yang disebarkan oleh Access Point.</indent>\r\n\r\n\u2022
    <indent=5%>Arah antena (pointing) dari kedua perangkat di masing-masing tower
    harus disejajarkan dan berhadapan secara presisi untuk mendapatkan kualitas sinyal
    yang stabil.</indent>"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
  m_sharedMaterial: {fileID: 2180264, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
