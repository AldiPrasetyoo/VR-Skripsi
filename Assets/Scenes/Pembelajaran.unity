  m_Name: 
  m_EditorClassIdentifier: Unity.TextMeshPro::TMPro.TextMeshProUGUI
  m_Material: {fileID: 0}
  m_Color: {r: 1, g: 1, b: 1, a: 1}
  m_RaycastTarget: 1
  m_RaycastPadding: {x: 0, y: 0, z: 0, w: 0}
  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "\u2022 <indent=5%>Menyediakan banyak ketersediaan port fisik RJ45 untuk
    menyambungkan sekumpulan komputer, server, hingga titik akses nirkabel ke dalam
    satu sistem jaringan terpadu.</indent>\r\n\r\n\u2022 <indent=5%>Mengirimkan aliran
    informasi hanya ke perangkat tujuan yang spesifik sehingga kapasitas transfer
    atau bandwidth di dalam jaringan lokal tidak terbuang sia sia.</indent>\n\n\u2022
    <indent=5%>Memisahkan setiap port antarmukanya ke dalam jalur komunikasi yang
    independen sehingga puluhan komputer bisa saling mengirim dan mengunduh data
    di waktu yang bersamaan tanpa memicu tabrakan sinyal atau bentrokan data.</indent>"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
  m_sharedMaterial: {fileID: 2180264, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
