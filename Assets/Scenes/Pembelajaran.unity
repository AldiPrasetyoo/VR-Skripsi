  m_Maskable: 1
  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: NanoStation memiliki dua port ethernet, yaitu port Main untuk menerima
    pasokan daya dan data PoE, serta port Secondary dengan fitur PoE Passthrough
    untuk menyalurkan listrik ke perangkat lain seperti IP Camera. Seluruh pengaturan
    dan manajemen jaringan dikelola secara praktis melalui sistem operasi airOS berbasis
    web. Melalui antarmuka web bawaan tersebut, pengguna dapat dengan leluasa melakukan
    berbagai konfigurasi, seperti menetapkan alamat IP, memilih lebar saluran dan
    frekuensi operasional yang bebas dari gangguan, menerapkan protokol keamanan
    enkripsi, hingga memantau kualitas dan stabilitas transmisi data selama radio
    tersebut menyala.
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
  m_sharedMaterial: {fileID: 2180264, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
