  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "\u2022 <indent=5%>Point to Point digunakan untuk memperkuat jangkauan
    jaringan dari satu lokasi ke lokasi lainnya.</indent>\r\n\r\n\u2022 <indent=5%>Membantu
    membagikan akses jaringan internet tanpa perlu menarik kabel dalam jarak yang
    jauh.</indent>\r\n\r\n\u2022 <indent=5%>Digunakan untuk menghubungkan jaringan
    antara dua gedung yang berbeda lokasi dapat saling terhubung dan berkomunikasi.</indent>\r\n\r\n\u2022
    <indent=5%>Dengan koneksi Point to Point perangkat yang berada di dua lokasi
    berbeda dapat bekerja layaknya berada di satu jaringan yang sama atau berada
    di lokasi yang sama.</indent>"
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
