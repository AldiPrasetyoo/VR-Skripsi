  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: 'PoE, kependekan dari Power over Ethernet, adalah teknologi yang memungkinkan
    sumber listrik dan koneksi data melalui satu kabel. Ini menghilangkan kebutuhan
    akan sumber daya listrik terpisah atau stopkontak listrik untuk perangkat jaringan,
    membuat instalasi jaringan lebih mudah diakses dan efisien. Teknologi POE dapat
    memberikan daya listrik ke perangkat jaringan, seperti kamera keamanan, telepon
    IP, NanoStation, dan aplikasi industri.

'
  m_isRightToLeft: 0
  m_fontAsset: {fileID: 11400000, guid: 8f586378b4e144a9851e7b34d9b748ee, type: 2}
