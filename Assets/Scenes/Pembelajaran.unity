  m_OnCullStateChanged:
    m_PersistentCalls:
      m_Calls: []
  m_text: "\u2022 <indent=5%>Efisiensi Biaya dan Waktu: Jauh lebih murah dan cepat
    dipasang dibandingkan harus menggelar kabel fisik (seperti fiber optik) melintasi
    jarak yang jauh atau medan geografis yang sulit.</indent>\r\n\r\n\u2022 <indent=5%>Bandwidth
    Maksimal (Dedicated Link): Karena jaringan hanya terhubung secara khusus antara
    dua titik, seluruh kapasitas kecepatan data (throughput) dapat dinikmati penuh
    tanpa terbagi dengan pengguna lain.</indent>\r\n\r\n\u2022 <indent=5%>Jangkauan
    Jarak Jauh: Mampu menjembatani jaringan antar wilayah yang terpisah hingga hitungan
    kilometer selama spesifikasi perangkat radio yang digunakan memadai.</indent>\r\n\r\n\u2022
    <indent=5%>Keamanan Lebih Terjamin: Sinyal dipancarkan secara terarah (directional)
    langsung ke perangkat penerima, sehingga jauh lebih sulit untuk diintersepsi
    atau disadap dibandingkan sinyal Wi-Fi biasa.</indent>"
  m_isRightToLeft: 0
